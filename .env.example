# Imaginarium Forge — environment example.
# Copy to `.env` (never commit `.env`; it is gitignored).
IMF_APP_ENV=local
IMF_LOG_LEVEL=INFO
IMF_LOG_FORMAT=text
# Store the exact provider-visible system/user text for FUTURE story runs.
# Set false for data minimisation; hashes and UTF-8 byte sizes remain stored.
# Changing this setting never rewrites historical runs. Restart the app.
IMF_STORE_RENDERED_GENERATION_MESSAGES=true
# A RUNNING story-generation record older than this many seconds may be
# recovered after a process interruption when no matching worker is active.
IMF_STALE_RUNNING_RUN_THRESHOLD_S=3600

# Loopback keeps story/character prompts on this machine by default.
# A non-loopback provider can receive sensitive text: the UI requires explicit
# confirmation for every send and rejects credentials, invalid URLs, and
# non-HTTPS remote endpoints. This setting does not enable ComfyUI execution.
IMF_OLLAMA_BASE_URL=http://localhost:11434
IMF_OLLAMA_TIMEOUT_S=120
# Explicit model downloads can be much slower than text generation.
IMF_OLLAMA_PULL_TIMEOUT_S=1800
# Ollama model keep-alive after each call ("5m", "0" = unload immediately).
IMF_OLLAMA_KEEP_ALIVE=5m
# "schema" (JSON schema via Ollama `format`) or "json_mode" (fallback).
IMF_STRUCTURED_MODE=schema
# Default model for benchmarks/spike, e.g. qwen3:8b (leave empty to pass --model).
IMF_DEFAULT_MODEL=

# Optional OpenAI Responses API provider. Ollama/offline remains the default;
# these values do not make a remote call until OpenAI is explicitly selected.
# Only the official endpoint is accepted until a matching remote-privacy gate
# is implemented for custom endpoints.
IMF_OPENAI_BASE_URL=https://api.openai.com/v1
IMF_OPENAI_MODEL=gpt-5.6
IMF_OPENAI_TIMEOUT_S=120
IMF_OPENAI_MAX_OUTPUT_TOKENS=8192
# Keep the key OUT of this file so it cannot enter project copies/backups.
# Set it only in the launch process, for example in PowerShell:
#   $env:OPENAI_API_KEY = Read-Host -MaskInput "OpenAI API key"
# A UI may alternatively pass the key as an in-memory runtime secret.

IMF_DATA_DIR=data
IMF_GOLDENSET_DIR=goldenset
